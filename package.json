{
  "name": "api-express-typescript",
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "prod": "node dist/main.js",
    "dev": "npx tsx watch src/main.ts",
    "check": "npx tsc",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npx tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:setup": "node src/cmd/db/setup.ts",
    "db:create": "npx node-pg-migrate --m src/database/migrations create",
    "db:migrate": "node src/cmd/db/migrate.ts up",
    "db:rollback": "node src/cmd/db/migrate.ts down"
  },
  "keywords": [
    "api",
    "expressjs",
    "nodejs",
    "typescript",
    "javascript"
  ],
  "author": "Agung Laksono",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "morgan": "^1.11.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.1.63",
    "@swc/core": "^1.15.43",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
